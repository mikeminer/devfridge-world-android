<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- MWA 2.0.7 transitively includes AndroidX test-core in runtime dependencies.
             Keep the SDK classes intact, but do not publish its instrumentation-only
             launch activities. Debug and androidTest manifests retain their helpers.
             MissingClass is ignored only for these removal markers, which cannot
             declare an activity in the merged release manifest. -->
        <activity android:name="androidx.test.core.app.InstrumentationActivityInvoker$BootstrapActivity"
            tools:node="remove" tools:ignore="MissingClass" />
        <activity android:name="androidx.test.core.app.InstrumentationActivityInvoker$EmptyActivity"
            tools:node="remove" tools:ignore="MissingClass" />
        <activity android:name="androidx.test.core.app.InstrumentationActivityInvoker$EmptyFloatingActivity"
            tools:node="remove" tools:ignore="MissingClass" />
    </application>
</manifest>
